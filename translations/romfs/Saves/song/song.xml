<Root>
	<song songName="퀀텀 노바" tag="SONG_QUANTUM_NOVA" charaTag="CHARA_QUANTUM_NOVA" imageNo="0" singer="CHARA_CASTY" genomapTag="GENOMAP_D_CASTY" ini_pos="0,220,0" ini_rot="30" harmo_00="30" harmo_01="40" harmo_02="50" harmo_03="60" in_out="0" sad_maso="0" skill_tag_support="SKILL_SONG_QUANTUM_ASSIST" skill_tag_small="SKILL_SONG_QUANTUM_SPELLCAST" skill_tag_big="SKILL_SONG_QUANTUM_FINISH" power="1" typeText="시마법 데미지" text="캐스가 처음부터 소지하고 있는 시마법. 빛의 에너지를 증폭할 뿐인 단순한 것이지만, 제대로 노래하면 나름대로 위력이 나온다. 몇 년 전 델타와 함께 자아낸 시마법으로, 그 이후로 줄곧 이 시마법 하나로 버텨왔다."/>
	<song songName="츤데레인" tag="SONG_TSUNDELEIN" charaTag="CHARA_TSUNDELEIN" imageNo="1" singer="CHARA_CASTY" genomapTag="GENOMAP_D_CASTY" ini_pos="205,0,0" ini_rot="0" harmo_00="35" harmo_01="50" harmo_02="55" harmo_03="60" in_out="100" sad_maso="100" skill_tag_support="SKILL_SONG_TSUNDE_ASSIST" skill_tag_small="SKILL_SONG_TSUNDE_SPELLCAST" skill_tag_big="SKILL_SONG_TSUNDE_FINISH" power="1" typeText="ＷＡＶＥ 수 데미지" text="캐스의 마음속 저항이 구체화된 존재. 츤데레는 모든 것에 저항해 자신의 정신과 소중한 사람을 지키려는 심리 작용이며, 캐스는 이를 통해 델타를 위험한 마음속으로 들이는 것을 거부했다."/>
	<song songName="뉴로킬러Ｚ" tag="SONG_NYUROKILLERZ" charaTag="CHARA_NYUROKILLERZ_WAIT" imageNo="2" singer="CHARA_CASTY" genomapTag="GENOMAP_D_SARLY" ini_pos="0,0,0" ini_rot="30" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="55" in_out="50" sad_maso="50" skill_tag_support="SKILL_SONG_NYUROKI_ASSIST" skill_tag_small="SKILL_SONG_NYUROKI_SPELLCAST" skill_tag_big="SKILL_SONG_NYUROKI_FINISH" power="2" typeText="관통 데미지" text="캐스와 살리가 함께 어릴 적부터 아주 좋아했던 마스코트 캐릭터. 뉴로키는 두 사람에게 있어 공통된 멋진 추억이다. 그 때문에, 살리의 냉철한 정신 표현을 완화하기 위한 요소로서 정신 세계에서 사용되고 있는 듯하다."/>
	<song songName="스파르탄・리브" tag="SONG_SPARTAN_LIB" charaTag="CHARA_SPARTAN_LIB" imageNo="3" singer="CHARA_CASTY" genomapTag="GENOMAP_D_NAY" ini_pos="0,0,0" ini_rot="0" harmo_00="25" harmo_01="35" harmo_02="45" harmo_03="65" in_out="50" sad_maso="0" skill_tag_support="SKILL_SONG_SPARTAN_ASSIST" skill_tag_small="SKILL_SONG_SPARTAN_SPELLCAST" skill_tag_big="SKILL_SONG_SPARTAN_FINISH" power="2" typeText="시마법 데미지" text="네이는 가혹한 과거를 겪으며 어떤 위험도 즐길 수 있도록 자신의 마음을 바꿔 왔다. 그때 탄생한 것이 스파르탄・리브. 실패가 곧 죽음인 데스 게임에서 살아남으려면 그녀의 존재가 필수였다."/>
	<song songName="브라이덜 론치" tag="SONG_BRIDAL_LAUNCH" charaTag="CHARA_BRIDAL_LAUNCH" imageNo="4" singer="CHARA_CASTY" genomapTag="GENOMAP_D_SARLY" ini_pos="0,170,0" ini_rot="30" harmo_00="30" harmo_01="40" harmo_02="50" harmo_03="55" in_out="0" sad_maso="50" skill_tag_support="SKILL_SONG_BRIDAL_ASSIST" skill_tag_small="SKILL_SONG_BRIDAL_SPELLCAST" skill_tag_big="SKILL_SONG_BRIDAL_FINISH" power="3" typeText="적 수 비례 데미지" text="사랑과 인정을 비효율적이라 생각하는 살리가, 자신의 마음속에 분명히 존재하는 사랑을 인정했을 때 브라이덜 론치는 탄생했다. 하지만 그녀는 또한, 사랑으로 인해 발생하는 다양한 불안을 체현한 존재이기도 하다."/>
	<song songName="토인 스톨러" tag="SONG_TOYINSTALLER" charaTag="CHARA_TOYINSTALLER" imageNo="5" singer="CHARA_CASTY" genomapTag="GENOMAP_D_KANON" ini_pos="70,0,-140" ini_rot="0" harmo_00="25" harmo_01="35" harmo_02="60" harmo_03="65" in_out="-100" sad_maso="-100" skill_tag_support="SKILL_SONG_TOYIN_ASSIST" skill_tag_small="SKILL_SONG_TOYIN_SPELLCAST" skill_tag_big="SKILL_SONG_TOYIN_FINISH" power="3" typeText="관통 데미지" text="매일 수행에 전념해 온 카논은 주변의 유혹으로부터 자신을 다스리기 위해 놀이를 전부 부정해 왔다. 그 심리를 체현한 것이, 장난감을 조합하여 흉폭한 용을 표현한 이 시마법이다. 놀이는 악이라는 심리 표현이다."/>
	<song songName="시조이드로피아" tag="SONG_SCHIZOIDLOPHIA" charaTag="CHARA_SCHIZOIDLOPHIA" imageNo="6" singer="CHARA_CASTY" genomapTag="GENOMAP_D_NERO" ini_pos="30,0,-30" ini_rot="230" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="65" in_out="-50" sad_maso="-50" skill_tag_support="SKILL_SONG_SCHIZO_ASSIST" skill_tag_small="SKILL_SONG_SCHIZO_SPELLCAST" skill_tag_big="SKILL_SONG_SCHIZO_FINISH" power="4" typeText="시마법 데미지" text="과거 캐스에게 구조된 네로는, 자신을 도와준 캐스가 순수한 마음을 계속 간직하길 바랐다. 하지만 캐스는 타산적이고 어른스러운 대응을 동경했고, 두 마음의 충돌로 이 시마법이 탄생했다."/>
	<song songName="페미니사트" tag="SONG_FEMINISAT" charaTag="CHARA_FEMINISAT" imageNo="7" singer="CHARA_CASTY" genomapTag="GENOMAP_D_SHIROTAKA" ini_pos="0,215,0" ini_rot="0" harmo_00="35" harmo_01="50" harmo_02="50" harmo_03="60" in_out="-50" sad_maso="0" skill_tag_support="SKILL_SONG_FEMINI_ASSIST" skill_tag_small="SKILL_SONG_FEMINI_SPELLCAST" skill_tag_big="SKILL_SONG_FEMINI_FINISH" power="3" typeText="ＷＡＶＥ 수 데미지" text="시로타카가 괴로운 현실을 피해 빠져든 가상 세계를 만들어내던 존재. 쉽게 말해 시로타카의 망상이 구체화된 것으로, 본래는 그의 창조력과 재능의 상징이었다."/>
	<song songName="리보・팬데믹스" tag="SONG_RIBO_PANDEMICS" charaTag="CHARA_RIBO_PANDEMICS" imageNo="8" singer="CHARA_CASTY" genomapTag="GENOMAP_D_ZILL" ini_pos="170,0,0" ini_rot="25" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="55" in_out="0" sad_maso="-50" skill_tag_support="SKILL_SONG_RIBO_ASSIST" skill_tag_small="SKILL_SONG_RIBO_SPELLCAST" skill_tag_big="SKILL_SONG_RIBO_FINISH" power="4" typeText="관통 데미지" text="강제로 체인을 걸어온 질이 캐스의 소중한 마음을 빼앗기 위해 창조한 정신 병기. 이 시마법으로 인해 캐스의 세계는 황야가 되어버렸지만, 가장 소중했던 보물 상자는 이 시마법의 힘을 가지고도 열 수 없었다."/>
	<song songName="아르시엘스피어" tag="SONG_AR_CIEL_SPHERE" charaTag="CHARA_AR_CIEL_SPHERE" imageNo="9" singer="CHARA_CASTY" genomapTag="GENOMAP_D_CASTY" ini_pos="100,100,0" ini_rot="30" harmo_00="25" harmo_01="35" harmo_02="50" harmo_03="65" in_out="100" sad_maso="-100" skill_tag_support="SKILL_SONG_AR_CIEL_ASSIST" skill_tag_small="SKILL_SONG_AR_CIEL_SPELLCAST" skill_tag_big="SKILL_SONG_AR_CIEL_FINISH" power="5" typeText="시마법 데미지" text="세계 공통 언어인 사랑을 이 세계 전체에 널리 전할 수 있게 된 캐스. 멀리 떨어진 아르시엘과 사랑을 통해 잠재의식으로 연결된 결과, 초월적인 힘을 부여받는 데 성공했다. 하지만 영상은 어디까지나 이미지입니다."/>
	<song songName="빛의 마음" tag="SONG_LIGHT_HYMMN" charaTag="CHARA_LIGHT_HYMMN" imageNo="10" singer="CHARA_ION" genomapTag="GENOMAP_A_ION" ini_pos="30,80,50" ini_rot="30" harmo_00="30" harmo_01="40" harmo_02="50" harmo_03="60" in_out="0" sad_maso="0" skill_tag_support="SKILL_SONG_HIKARI_ASSIST" skill_tag_small="SKILL_SONG_HIKARI_SPELLCAST" skill_tag_big="SKILL_SONG_HIKARI_FINISH" power="1" typeText="시마법 데미지" text="이온이 자신을 지켜줄 수호자를 바라는 마음으로 공상한 귀여운 로봇. 외모와 달리 강력한 발톱으로 높은 살상력을 지녔다. 이온의 공상이 수호자를 구현했다면 아셰스는 이런 모습이었을지도 모른다."/>
	<song songName="츈피" tag="SONG_CHUMPI" charaTag="CHARA_CHUMPI" imageNo="11" singer="CHARA_ION" genomapTag="GENOMAP_A_KANON" ini_pos="0,170,0" ini_rot="15" harmo_00="35" harmo_01="50" harmo_02="55" harmo_03="60" in_out="100" sad_maso="100" skill_tag_support="SKILL_SONG_CHUMPI_ASSIST" skill_tag_small="SKILL_SONG_CHUMPI_SPELLCAST" skill_tag_big="SKILL_SONG_CHUMPI_FINISH" power="1" typeText="적 수 비례 데미지" text="참새를 무척 좋아하는 카논의 마음속에도 참새가 살고 있었다. 그것도 신격화된 모습으로. 츈피는 귀여운 것을 좋아하는 카논의 성향이 구체화된 존재이자, 자신감 부족을 드러내는 매개체다."/>
	<song songName="거짓된 꽃" tag="SONG_ARTIFICIAL_FLOWER" charaTag="CHARA_ARTIFICIAL_FLOWER" imageNo="12" singer="CHARA_ION" genomapTag="GENOMAP_A_NAY" ini_pos="0,190,0" ini_rot="30" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="55" in_out="50" sad_maso="50" skill_tag_support="SKILL_SONG_ARTIFIC_ASSIST" skill_tag_small="SKILL_SONG_ARTIFIC_SPELLCAST" skill_tag_big="SKILL_SONG_ARTIFIC_FINISH" power="2" typeText="관통 데미지" text="강대한 힘이 있어도 자신의 안위를 위해 쓸 수 없는 네이의 딜레마가 구체화된 존재. 힘을 쓰면 적대 세력으로 오해받을까 두려워 민중을 돕지 못하는 고뇌가 발현된 것이다."/>
	<song songName="유우키의 증표" tag="SONG_YUKI_IDENTITY" charaTag="CHARA_YUKI_IDENTITY" imageNo="13" singer="CHARA_ION" genomapTag="GENOMAP_A_ION" ini_pos="0,250,0" ini_rot="0" harmo_00="25" harmo_01="35" harmo_02="45" harmo_03="65" in_out="50" sad_maso="0" skill_tag_support="SKILL_SONG_YUKI_ASSIST" skill_tag_small="SKILL_SONG_YUKI_SPELLCAST" skill_tag_big="SKILL_SONG_YUKI_FINISH" power="2" typeText="시마법 데미지" text="이온이 플레이어에게 더욱 직접적인 세계 간섭 권한을 부여한 것이며, 이로써 플레이어는 컨트롤러를 사용해 직접 적을 쓸어버릴 수 있게 된다. 이온이 플레이어를 한 단계 더 깊게 인정한 증거."/>
	<song songName="아메노무라쿠모 신권" tag="SONG_AMENO_MURAKUMONO_MIKUJI" charaTag="CHARA_AMENO_MURAKUMONO_MIKUJI" imageNo="14" singer="CHARA_ION" genomapTag="GENOMAP_A_KANON" ini_pos="100,0,-100" ini_rot="55" harmo_00="30" harmo_01="40" harmo_02="50" harmo_03="55" in_out="0" sad_maso="50" skill_tag_support="SKILL_SONG_AMENO_ASSIST" skill_tag_small="SKILL_SONG_AMENO_SPELLCAST" skill_tag_big="SKILL_SONG_AMENO_FINISH" power="3" typeText="ＷＡＶＥ 수 데미지" text="카논의 위에는 강권을 지닌 존재가 있었다. 정점의 역할을 맡았지만 실제로는 꼭두각시였고, 그 사실은 마음에 그림자를 드리웠다. 결국 카논은 남에게 의지하거나 신에게 매달리지 않고서는 일을 결정하지 못하게 되었다."/>
	<song songName="등대지기의 밤" tag="SONG_LIGHTHOUSE_NIGHT" charaTag="CHARA_LIGHTHOUSE_NIGHT" imageNo="15" singer="CHARA_ION" genomapTag="GENOMAP_A_NELICO" ini_pos="0,0,0" ini_rot="0" harmo_00="25" harmo_01="35" harmo_02="60" harmo_03="65" in_out="-100" sad_maso="-100" skill_tag_support="SKILL_SONG_LIGHT_ASSIST" skill_tag_small="SKILL_SONG_LIGHT_SPELLCAST" skill_tag_big="SKILL_SONG_LIGHT_FINISH" power="3" typeText="관통 데미지" text="이온을 잠재워 그 생명력으로 샤르를 탄생시키는 역할을 맡았던 존재, 네리코. 하지만 그녀의 분방한 성격이 이온의 마음을 치유해 주었던 것도 사실이었다. 그런 장난기 가득한 네리코를 이온 나름대로 표현한 시마법이다."/>
	<song songName="기갑염희" tag="SONG_SEXY_MOBILE_SUIT" charaTag="CHARA_SEXY_MOBILE_SUIT" imageNo="16" singer="CHARA_ION" genomapTag="GENOMAP_A_RENALL" ini_pos="50,0,100" ini_rot="15" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="65" in_out="-50" sad_maso="-50" skill_tag_support="SKILL_SONG_SEXY_ASSIST" skill_tag_small="SKILL_SONG_SEXY_SPELLCAST" skill_tag_big="SKILL_SONG_SEXY_FINISH" power="4" typeText="시마법 데미지" text="이온, 즉 아셰스의 유키 네이를 이쪽 세계로 납치해 온 주모자 중 한 명으로서, 레나루루는 줄곧 자책감에 시달려 왔다. 그런 자신을 끊임없이 몰아세우며, 매일같이 정신적 자살을 하기 위해 만들어낸 존재이다."/>
	<song songName="나에게는 인세 수입이 없어." tag="SONG_I_HAVE_NO_ROYALTIES" charaTag="CHARA_I_HAVE_NO_ROYALTIES" imageNo="17" singer="CHARA_ION" genomapTag="GENOMAP_A_SHIROTAKA" ini_pos="58,0,85" ini_rot="65" harmo_00="35" harmo_01="50" harmo_02="50" harmo_03="60" in_out="-50" sad_maso="0" skill_tag_support="SKILL_SONG_I_HAVE_ASSIST" skill_tag_small="SKILL_SONG_I_HAVE_SPELLCAST" skill_tag_big="SKILL_SONG_I_HAVE_FINISH" power="3" typeText="적 수 비례 데미지" text="이온과 가까웠던 만화가 세오 레오. 그가 그린 만화의 히로인 아즈미노 피코가 이 시마법의 딸이다. 시로타카는 이온의 기억 속 그에게 공감하고 자신의 과거를 투영해 이 시마법을 창조했다."/>
	<song songName="코쿠신락×천통희" tag="SONG_TOKI_KAGURA_TENTOU_KI" charaTag="CHARA_TOKI_KAGURA_TENTOU_KI" imageNo="18" singer="CHARA_ION" genomapTag="GENOMAP_A_NAY" ini_pos="0,0,0" ini_rot="45" harmo_00="25" harmo_01="45" harmo_02="50" harmo_03="55" in_out="0" sad_maso="-50" skill_tag_support="SKILL_SONG_TOKI_ASSIST" skill_tag_small="SKILL_SONG_TOKI_SPELLCAST" skill_tag_big="SKILL_SONG_TOKI_FINISH" power="4" typeText="시마법 데미지" text="이온에게 모든 것을 빼앗겼다고 여긴 네이는 계속 그녀를 탓했다. 하지만 그것은 이온과의 관계를 붙잡고 공의존을 유지하기 위한 구실에 불과했다. 네이는 이를 극복해 이온과 건전한 관계를 맺는다."/>
	<song songName="제7세계 신시" tag="SONG_7TH_WORLDS_REVELATION" charaTag="CHARA_7TH_WORLDS_REVELATION" imageNo="19" singer="CHARA_ION" genomapTag="GENOMAP_A_ION" ini_pos="50,0,-60" ini_rot="0" harmo_00="25" harmo_01="35" harmo_02="50" harmo_03="65" in_out="100" sad_maso="-100" skill_tag_support="SKILL_SONG_7TH_WORLDS_ASSIST" skill_tag_small="SKILL_SONG_7TH_WORLDS_SPELLCAST" skill_tag_big="SKILL_SONG_7TH_WORLDS_FINISH" power="5" typeText="관통 데미지" text="이온이 원래 있던 세계, 즉 이쪽 세계인 아셰스와 지금 있는 세계인 쉘의 콜라보레이션. 판타지적인 드래곤과 어스의 근대 군사 병기를 융합시킨 그것은, 오직 이온만이 만들어낼 수 있는 존재이다."/>
