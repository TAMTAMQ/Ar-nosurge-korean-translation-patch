			</node>
			<!--イコライザー ボイス再生中演出-->
			<anim_ctrl name="eq_play" play="false" loop="true" speed="0.6">
				<bind_node node="eq_r/eq_0" anim="anm_msgwin_eq0"/>
				<bind_node node="eq_r/eq_1" anim="anm_msgwin_eq1"/>
				<bind_node node="eq_r/eq_2" anim="anm_msgwin_eq2"/>
				<bind_node node="eq_r/eq_3" anim="anm_msgwin_eq3"/>
