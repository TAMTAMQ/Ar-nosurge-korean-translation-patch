			<text name="msg_text" pos="78,40.333" drop_shadow="false" limit_width="616" font_size="28" text="아이우에오카키쿠케코아이우에오카키쿠케코\n아이우에오카키쿠케코아이우에오카키쿠케코\n아이우에오카키쿠케코아이우에오카"/>
			<!--名前表示欄-->
			<node name="name_base" pos="16,-18">
				<image name="name_base_img" pos="0,-13.333" scale="1.7,1.7,0" style="gen_common02_acce02"/>
				<text name="name_text" pos="15,7" drop_shadow="false" font_size="25.333" text="캐스캐스"/>
			</node>
			<!--名前表示欄の左で光ってる輪-->
			<image name="light" pos="-3,-35.333" style="gen_common02_acce03"/>
