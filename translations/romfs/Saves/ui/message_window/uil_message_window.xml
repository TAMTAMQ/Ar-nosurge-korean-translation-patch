				<anim_ctrl play="true" loop="true">
					<bind_node node="light_base" anim="anm_common_rotateZ360" speed="0.03"/>
				</anim_ctrl>
			</node>
			<!--イコライザー右側-->
			<node name="eq_r" pos="546.667,210.667" scale="-1,-1,1" color="255,255,255,64">
				<image name="eq_0" pos="0,0" image_no="0" style="style_msgwin_voiceline"/>
				<image name="eq_1" pos="5,0" image_no="0" style="style_msgwin_voiceline"/>
				<image name="eq_2" pos="10,0" image_no="0" style="style_msgwin_voiceline"/>
				<image name="eq_3" pos="15,0" image_no="0" style="style_msgwin_voiceline"/>
			</node>
			<!--イコライザー左側-->
			<node name="eq_l" pos="199,210.667" scale="1,-1,1" color="255,255,255,64">
