	<command load_style="Saves/ui/message_window/uis_message_window.xml"/>
	<command load_anim="Saves/ui/message_window/uia_message_window.xml"/>
	<!--パネルの両左右下の土台-->
	<node name="base" visible="false" viewer_visible="true">
