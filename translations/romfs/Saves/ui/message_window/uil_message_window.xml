		<!--土台に当るパーツ-->
		<image pos="0,105" style="gen_common02_acce01"/>
		<image pos="793.667,105" scale="-1,1,1" style="gen_common02_acce01"/>
	</node>
	<!--入場演出-->
	<anim_ctrl name="anim_enter" start_visible="true" play="true" loop="false" reverse="false" speed="2.0">
		<bind_node node="base" anim="anm_msgwin_base_pull_up"/>
		<bind_node delay="0.2" node="panel" anim="anm_msgwin_panel_pull_up"/>
		<bind_node delay="0.4" node="msg_text" anim="anm_msgwin_fade_in" speed="1.5"/>
	</anim_ctrl>
</root>
