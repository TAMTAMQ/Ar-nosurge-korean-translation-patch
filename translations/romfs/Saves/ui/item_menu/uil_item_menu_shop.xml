		<node name="tab" pos="2,-24" load="Saves/ui/item_menu/uil_item_menu_tab.xml"/>
	</node>
	<anim_ctrl name="get_in" start_visible="true">
		<bind_node node="top" speed="1.0" anim="anm_common_fade_in"/>
