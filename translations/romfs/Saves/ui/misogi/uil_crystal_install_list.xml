<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE root SYSTEM "file://st01/project/acps3/_Programmer/ui/uil.dtd">
<root>
	<!-- スタイルの読み込み -->
	<command load_style="Saves/ui/gen_styles/uis_gen_common.xml"/>
	<command load_style="Saves/ui/gen_styles/uis_gen_window.xml"/>
	<command load_style="Saves/ui/gen_styles/uis_gen_bath.xml"/>
	<command load_anim="Saves/ui/misogi/uia_misogi_common.xml"/>
	<!--
  <image style="ui_bg_sample" color="255,255,255,255" />
  -->
	<node visible="false">
		<node name="menu_item_template" visible="true">
			<image name="window_bg_off" pos="0,0" size_wh="424,94" style="gen_window02_04_off" visible="true"/>
			<image name="window_bg_on" pos="0,0" size_wh="424,94" style="gen_window02_04_on" visible="false"/>
			<image name="point_icon_bg" pos="23,34" style="gen_bath02_bodyparts__bg"/>
			<image name="point_icon" pos="23,34" style="gen_bath02_bodyparts" image_no="0"/>
			<image name="crystal_bg" pos="86,30" size_wh="320,38" style="gen_window03_bg02"/>
			<image name="crystal_icon" pos="98,33" style="gen_bath02_crystalicon" image_no="0"/>
			<text name="crystal_name" pos="135,37" text="아이우에오카키쿠케코" align="left" font_size="22"/>
			<text name="crystal_text" pos="95,72" text="아이우에오카키쿠케코사시스세소" align="left" font_size="20"/>
			<image name="window_highlight" pos="0,0" size_wh="424,97" style="gen_window02_04_highlight" visible="false"/>
			<anim_ctrl name="blink_icon" loop="true">
				<bind_node node="point_icon" anim="anm_common_blink"/>
			</anim_ctrl>
		</node>
	</node>
	<node name="points" pos="32,90" visible="true">
		<node name="point00" pos="0,0" clone_child_tree="menu_item_template"/>
		<node name="point01" pos="0,104" clone_child_tree="menu_item_template"/>
		<node name="point02" pos="0,208" clone_child_tree="menu_item_template"/>
		<node name="point03" pos="0,312" clone_child_tree="menu_item_template"/>
		<node name="point04" pos="0,416" clone_child_tree="menu_item_template"/>
	</node>
	<node name="select" pos="32,13" clone_child_tree="menu_item_template" visible="true"/>
	<!-- フェードアニメーション -->
	<anim_ctrl name="msg_anim_points_fade_in" play="false" loop="false">
		<bind_node node="points" anim="anim_alpha_on"/>
	</anim_ctrl>
	<anim_ctrl name="msg_anim_points_fade_out" play="false" loop="false">
		<bind_node node="points" anim="anim_alpha_on" reverse="true"/>
	</anim_ctrl>
	<anim_ctrl name="msg_anim_select_fade_in" play="false" loop="false">
		<bind_node node="select" anim="anim_alpha_on"/>
	</anim_ctrl>
	<anim_ctrl name="msg_anim_select_fade_out" play="false" loop="false">
		<bind_node node="select" anim="anim_alpha_on" reverse="true"/>
	</anim_ctrl>
</root>
