<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE root SYSTEM "file://st01/project/acps3/_Programmer/ui/uil.dtd">
<root>
	<!-- スタイルの読み込み -->
	<command load_style="Saves/ui/etc/uis_item_list.xml"/>
	<command load_style="Saves/ui/gen_styles/uis_gen_common.xml"/>
	<command load_style="Saves/ui/gen_styles/uis_gen_bath.xml"/>
	<!--
  <image style="ui_bg_sample" color="128,128,128,128" />
  -->
	<!-- 項目のテンプレート -->
	<node visible="false">
		<node name="menu_item_template">
			<text name="item_text" pos="70,0" text="가나다순" align="left" font_size="22"/>
			<image name="item_icon" pos="32,-5" style="gen_bath02_crystalicon" visible="true"/>
			<image name="item_equip" pos="-5,-5" style="gen_common01_installicon" visible="true"/>
			<node name="item_new" visible="false">
				<image name="item_new01" pos="-10,-8" flick_time="0.2" style="gen_common01_new01"/>
				<image name="item_new02" pos="-33,-15" flick_time="0.2" style="gen_common01_new02"/>
			</node>
		</node>
	</node>
	<!-- メニュー本体 -->
	<!--
  <menu style="default_menu" name="menu" pos="40,139" disp_lines="6" size_w="410" item_height="44" disp_scroll_bar="true"/>
  -->
	<node name="menu_all">
		<menu style="style_menu_column1" name="menu" pos="40,144" disp_lines="6" size_w="410" item_height="44" disp_scroll_bar="true"/>
		<text text="결정 이름" pos="244,157" align="center" font_size="18"/>
	</node>
	<!-- フェードアニメーション -->
	<anim_ctrl name="fade_in" play="false" loop="false">
		<bind_node node="menu_all" anim="anm_common_fade_in"/>
	</anim_ctrl>
	<anim_ctrl name="fade_out" play="false" loop="false">
		<bind_node node="menu_all" anim="anm_common_fade_in" reverse="true"/>
	</anim_ctrl>
</root>
